rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // শুধু মালিকের ইমেইলের লগইন করা অ্যাকাউন্ট ডেটা পড়তে ও লিখতে পারবে।
    // ইমেইল বদলালে src/config/owner.ts-এও বদলাতে হবে।
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'taqwagadgetzone@gmail.com';
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
